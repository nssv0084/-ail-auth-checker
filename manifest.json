{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "0.2.6",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Hiroki Ikemoto",
  "homepage_url": "https://github.com/nssv0084/-ail-auth-checker",
  "icons": { "48": "icon48.png", "96": "icon96.png" },
  "background": {
    "scripts": ["parser.js", "background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": false
  },
  "permissions": [
    "messagesRead",
    "scripting",
    "storage",
    "https://rdap.verisign.com/*",
    "https://who.is/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-auth-checker@nssv0",
      "strict_min_version": "109.0"
    }
  }
}
